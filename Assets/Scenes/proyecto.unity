--- !u!114 &1124299646
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1124299644}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd9eb83a5680a0352a6e404cc2bc662d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  timeManager: {fileID: 310167787}
  soldiersDialogueList:
  - minute: 180
    speaker: {fileID: 1373006734}
    message: "\xBFNo es 25 de abril ya?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 184
    speaker: {fileID: 1373006734}
    message: "Qu\xE9 lo pario..."
    displayDuration: 1
    wasDisplayed: 0
  - minute: 185
    speaker: {fileID: 1373006734}
    message: "Y pensar que ya pasaron 22 d\xEDas desde que tomamos esta base."
    displayDuration: 5
    wasDisplayed: 0
  - minute: 370
    speaker: {fileID: 2098016617}
    message: "\xA1Los ingleses ya est\xE1n llegando!"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 370
    speaker: {fileID: 1980903898}
    message: "\xA1Los ingleses ya est\xE1n llegando!"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 374
    speaker: {fileID: 2098016617}
    message: "\xA1SON COMO 200!"
    displayDuration: 6
    wasDisplayed: 0
  - minute: 376
    speaker: {fileID: 2098016617}
    message: ...
    displayDuration: 3
    wasDisplayed: 0
  - minute: 380
    speaker: {fileID: 2098016617}
    message: "No permitir\xE9 que hayan m\xE1s bajas..."
    displayDuration: 3
    wasDisplayed: 0
  - minute: 205
    speaker: {fileID: 1373006734}
    message: "\xA1Ey! \xBFC\xF3mo andan?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 210
    speaker: {fileID: 1956095681}
    message: "\xA1Qu\xE9 fr\xEDo bestial!"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 208
    speaker: {fileID: 2096987028}
    message: "\xBFC\xF3mo est\xE1 la situaci\xF3n ac\xE1?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 211
    speaker: {fileID: 1373006734}
    message: Sospechosamente tranquila.
    displayDuration: 3
    wasDisplayed: 0
  - minute: 214
    speaker: {fileID: 2096987028}
    message: "\xBFA qu\xE9 se refiere con eso?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 217
    speaker: {fileID: 1373006734}
    message: "Hace dos d\xEDas se escucharon unos ruidos provenientes del norte."
    displayDuration: 3
    wasDisplayed: 0
  - minute: 220
    speaker: {fileID: 2096987028}
    message: "\xBFPudieron identificarlos?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 223
    speaker: {fileID: 1373006734}
    message: "No, este fr\xEDo es mortal ni con un helic\xF3ptero podr\xEDamos ir
      a investigar."
    displayDuration: 3
    wasDisplayed: 0
  - minute: 224
    speaker: {fileID: 1956095681}
    message: "\xBFD\xF3nde dejamos las provisiones?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 227
    speaker: {fileID: 1373006734}
    message: "Dejenlas sobre las mesas, no se preocupen mucho despu\xE9s las ordenamos."
    displayDuration: 3
    wasDisplayed: 0
  - minute: 215
    speaker: {fileID: 1980903898}
    message: "\xBFEs realmente necesario patrullar este camino?"
    displayDuration: 3
    wasDisplayed: 0
  - minute: 218
    speaker: {fileID: 1417947061}
    message: Si.
    displayDuration: 2
    wasDisplayed: 0
  - minute: 218
    speaker: {fileID: 1578059265}
    message: No.
    displayDuration: 2
    wasDisplayed: 0
  - minute: 221
    speaker: {fileID: 1578059265}
    message: ...
    displayDuration: 2
    wasDisplayed: 0
  - minute: 221
    speaker: {fileID: 1417947061}
    message: ...
    displayDuration: 2
    wasDisplayed: 0
  - minute: 224
    speaker: {fileID: 1578059265}
    message: "\xBFLo dec\xEDs por los ruidos que se escucharon el otro d\xEDa?"
    displayDuration: 4
    wasDisplayed: 0
  - minute: 229
    speaker: {fileID: 1417947061}
    message: No solo por eso, estamos en una guerra.
    displayDuration: 4
    wasDisplayed: 0
  - minute: 234
    speaker: {fileID: 1417947061}
    message: "Qui\xE9n sabe si lo \xFAnico que nos separa de los ingleses es este
      clima o estas monta\xF1as."
    displayDuration: 5
    wasDisplayed: 0
  - minute: 240
    speaker: {fileID: 1578059265}
    message: "No seas exagerado, podr\xEDa haber sido una avalancha."
    displayDuration: 3
    wasDisplayed: 0
